{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kunye.sema.json",
  "title": "Kitap künyesi",
  "type": "object",
  "required": ["slug", "baslik", "sair", "editor", "yayinci", "baski", "baskiYili", "isbn", "telifNotu", "izin", "siirSayisi", "siirKaynakOnekleri", "kaynakDosya"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
    "baslik": { "type": "string", "minLength": 1, "description": "Kartlarda ve başlıklarda görünen kısa ad (\"<Şair> Dîvânı\")" },
    "tamBaslik": { "type": "string", "description": "Kitabın tam adı; kaynak gösterimlerinde kullanılır" },
    "sair": { "type": "string", "minLength": 1 },
    "editor": { "type": "string" },
    "yayinci": { "type": "string", "minLength": 1 },
    "seri": { "type": "string" },
    "baski": { "type": "string" },
    "baskiYili": { "type": "integer", "minimum": 1800, "maximum": 2100 },
    "isbn": { "type": "string", "pattern": "^([0-9-]{10,17})?$", "description": "Kaynakta okunamıyorsa boş bırakılır (uydurulmaz)" },
    "telifNotu": { "type": "string", "minLength": 1 },
    "izin": {
      "type": "object",
      "required": ["durum", "kaynak", "tarih"],
      "additionalProperties": false,
      "properties": {
        "durum": { "enum": ["yok", "istendi", "yazili-izin-var", "reddedildi"] },
        "kaynak": { "type": "string", "description": "Yazılı iznin kaydı: yazışma dosyası ya da belge adı" },
        "tarih": { "type": "string", "description": "YYYY-AA-GG; durum 'yok' iken boş olabilir" }
      },
      "if": { "properties": { "durum": { "const": "yazili-izin-var" } } },
      "then": { "properties": { "kaynak": { "type": "string", "minLength": 1 }, "tarih": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } } }
    },
    "siirSayisi": {
      "description": "Kitabın kendi beyan ettiği şiir sayısı. Tek bölümlü kitapta sayı, çok bölümlüde kaynak-öneki -> sayı.",
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-z]$" }, "additionalProperties": { "type": "integer", "minimum": 1 } }
      ]
    },
    "siirSayisiKaynagi": { "type": "string" },
    "siirKaynakOnekleri": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-z]$" }, "additionalProperties": { "type": "string", "minLength": 1 } },
    "kaynakDosya": { "type": "string", "pattern": "^kaynak/.+[.](epub|pdf)$" },
    "kunyeNotu": { "type": "string" }
  }
}
