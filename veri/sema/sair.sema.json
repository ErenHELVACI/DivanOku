{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sair.sema.json",
  "title": "Şair/eser hakkındaki tanıtım bölümleri (veri/<kitap>/sair.json)",
  "type": "object",
  "required": ["kaynakDosyalar", "bolumler", "dipnotlar"],
  "additionalProperties": false,
  "properties": {
    "kaynakDosyalar": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "bolumler": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["baslik", "ogeler"], "additionalProperties": false,
        "properties": {
          "baslik": { "type": "string", "minLength": 1 },
          "ogeler": {
            "type": "array",
            "items": {
              "type": "object", "required": ["t", "m"], "additionalProperties": false,
              "properties": { "t": { "enum": ["ust", "alt", "p", "alinti"] }, "m": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "dipnotlar": {
      "type": "array",
      "items": {
        "type": "object", "required": ["no", "metin"], "additionalProperties": false,
        "properties": { "no": { "type": "integer", "minimum": 1 }, "metin": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
