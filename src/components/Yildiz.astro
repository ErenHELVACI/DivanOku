---
// Sekiz köşeli yıldız (iki üst üste bindirilmiş kare): Selçuklu-Osmanlı süslemesinden esinlenen sade bir motif.
interface Props { boy?: number; sinif?: string }
const { boy = 20, sinif = '' } = Astro.props;
---
<svg class={`yildiz ${sinif}`} width={boy} height={boy} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <rect x="5" y="5" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" />
  <rect x="5" y="5" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" transform="rotate(45 12 12)" />
  <circle cx="12" cy="12" r="2.2" fill="currentColor" />
</svg>
