---
import '@fontsource-variable/fraunces/index.css';
import '@fontsource-variable/figtree/index.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/600.css';
import '../styles/global.css';
import '../styles/cekmece.css';
import Yildiz from '../components/Yildiz.astro';
interface Props { baslik: string; aciklama?: string }
const { baslik, aciklama = 'Türkçe dîvânları telefonda ve bilgisayarda rahat okutan platform.' } = Astro.props;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={aciklama} />
    <!-- Özel sürüm: yazılı izin gelene kadar arama motorları görmesin (KURALLAR.md, Telif ve izin). -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f3e9d2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1224" media="(prefers-color-scheme: dark)" />
    <title>{baslik}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/ikon-192.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Dîvân" />
    <script is:inline>
      try { var t = localStorage.getItem('tema'); if (t === 'acik' || t === 'koyu') document.documentElement.dataset.tema = t; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="atla" href="#icerik">İçeriğe geç</a>
    <header class="ust">
      <div class="kap">
        <a class="marka" href="/"><Yildiz boy={22} />Dîvân</a>
        <nav class="menu" aria-label="Ana menü">
          <a href="/">Kitaplar</a>
          <a href="/ara/">Ara</a>
          <a href="/sozluk/">Sözlük</a>
          <button type="button" id="tema-dugme" aria-label="Açık ya da koyu temayı değiştir">☾ Tema</button>
        </nav>
      </div>
    </header>
    <main id="icerik" tabindex="-1">
      <div class="kap"><slot /></div>
    </main>
    <footer class="alt">
      <div class="kap">
        <Yildiz boy={18} />
        Özel sürüm: yayın izni alınmamıştır, herkese açık değildir.<br />Kitapların hakları ilgili yayıncıya aittir.<br /><a href="/cevrimdisi/">İnternetsiz okuma ve uygulama olarak kurma</a>
      </div>
    </footer>
    <script>
      // Servis işçisi: yalnızca yayın sürümünde (geliştirme sunucusunda önbellek sayfaların canlı yenilenmesini bozar)
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
      }
      // Çevrimdışı uyarısı
      const bant = document.createElement('div');
      bant.id = 'cevrimdisi-bant'; bant.setAttribute('role', 'status'); bant.hidden = navigator.onLine;
      bant.textContent = 'Çevrimdışısınız: indirilmiş sayfalar açılır.';
      document.body.append(bant);
      addEventListener('offline', () => (bant.hidden = false));
      addEventListener('online', () => (bant.hidden = true));
    </script>
    <script>
      const dugme = document.getElementById('tema-dugme')!;
      dugme.addEventListener('click', () => {
        const kok = document.documentElement;
        const suan = kok.dataset.tema ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'koyu' : 'acik');
        const yeni = suan === 'koyu' ? 'acik' : 'koyu';
        kok.dataset.tema = yeni;
        try { localStorage.setItem('tema', yeni); } catch {}
      });
    </script>
  </body>
</html>
