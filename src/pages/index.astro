---
import Temel from '../layouts/Temel.astro';
import Yildiz from '../components/Yildiz.astro';
import { kitaplar } from '../lib/veri.ts';

const liste = kitaplar();
const sayi = (s: number | Record<string, number>) => (typeof s === 'number' ? s : Object.values(s).reduce((a, b) => a + b, 0));
// Her cildin sırtına kendi rengi: lâcivert, şengerf, zümrüt, mor...
const ciltRenkleri = ['#23336b', '#8f2a1e', '#1f5a4a', '#5b2a62', '#7a5a14'];
---
<Temel baslik="Dîvân">
  <section class="karsila">
    <div class="tag">Türkçe dîvânlar</div>
    <h1>Dîvân</h1>
    <p class="ozet">Gönül şiirinin, telefonda da bilgisayarda da rahat okunan hâli.</p>
    <div class="ayrac"><Yildiz boy={22} /></div>
  </section>

  {liste.map((k, i) => (
    <div class="kitap-kart" style={`--cilt:${ciltRenkleri[i % ciltRenkleri.length]}`}>
      <span class="sirt" aria-hidden="true"></span>
      <div class="govde">
        {k.sair && <a class="sair-bilgi" href={`/${k.kunye.slug}/sair/`} aria-label={`${k.kunye.sair} hakkında bilgi`}>Şair hakkında ›</a>}
        <span class="sair">{k.kunye.sair}</span>
        <h2><a class="kart-ana" href={`/${k.kunye.slug}/`}>{k.kunye.baslik}</a></h2>
        <p class="kucuk soluk">Hazırlayan: {k.kunye.editor} · {k.kunye.baski}<br />{k.kunye.yayinci}</p>
        <span class="sayilar">
          <span><b>{sayi(k.kunye.siirSayisi)}</b>şiir</span>
          <span><b>{k.siirler.reduce((n, s) => n + s.bentler.length, 0)}</b>bent</span>
        </span>
      </div>
    </div>
  ))}

  <p style="text-align:center;margin-top:1.6rem"><a class="dugme" href="/sozluk/">Tüm sözlük: altı dîvânın sözlüğü bir arada →</a></p>
</Temel>
