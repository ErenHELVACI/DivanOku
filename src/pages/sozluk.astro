---
import Temel from '../layouts/Temel.astro';
import '../styles/sozluk.css';
import { genelSozluk, farkliAnlamlar } from '../lib/sozluk.ts';

const gruplar = genelSozluk();
const harfler = [...new Set(gruplar.map((g) => g.harf))].sort((a, b) => a.localeCompare(b, 'tr'));
const toplamMadde = gruplar.reduce((n, g) => n + g.maddeler.length, 0);
---
<Temel baslik="Tüm sözlük · Dîvân">
  <nav class="ekmek" aria-label="Konum"><a href="/">Kitaplar</a> › Tüm sözlük</nav>
  <header class="kitap-ust">
    <div class="sair">Altı dîvân</div>
    <h1>Tüm sözlük</h1>
    <p class="soluk kucuk">{gruplar.length} sözcük, {toplamMadde} madde. Dîvânlarda aynı sözcük için verilen farklı anlamlar bir arada sunulur; anlamlar kitaplardan olduğu gibi alınmıştır.</p>
  </header>

  <div class="araclar" role="search">
    <label class="sr-only" for="ara">Tüm sözlükte ara</label>
    <input type="search" id="ara" placeholder="Sözcük ara… (murâd, murad, muradı)" autocomplete="off" />
  </div>
  <p class="kucuk soluk" id="sayac" aria-live="polite">{gruplar.length} sözcük</p>

  <nav class="harfler" aria-label="Harfe git">
    {harfler.map((h) => <a href={`#h-${h}`}>{h}</a>)}
  </nav>

  <div class="sozluk-sayfa" id="liste">
    {harfler.map((h) => (
      <section class="harf-grup" id={`h-${h}`} aria-labelledby={`b-${h}`}>
        <h2 id={`b-${h}`} class="harf-baslik">{h}</h2>
        <dl>
          {gruplar.filter((g) => g.harf === h).map((g) => (
            <div class="madde coklu" data-anahtar={g.anahtar}>
              <dt>{g.baslik}</dt>
              <dd>
                {farkliAnlamlar(g.maddeler).map((x, i, h) => (
                  <p class="kaynakli">{h.length > 1 ? `${i + 1}. ` : ''}{x.t}</p>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
</Temel>

<script>
  import { normallestir } from '../lib/normallestir.ts';
  const ara = document.getElementById('ara') as HTMLInputElement;
  const sayac = document.getElementById('sayac')!;
  const gruplar = [...document.querySelectorAll<HTMLElement>('.harf-grup')];
  const maddeler = [...document.querySelectorAll<HTMLElement>('.madde')];
  ara.addEventListener('input', () => {
    const q = normallestir(ara.value);
    let n = 0;
    for (const s of maddeler) { const ok = !q || s.dataset.anahtar!.includes(q); s.hidden = !ok; if (ok) n++; }
    for (const g of gruplar) g.hidden = !g.querySelector('.madde:not([hidden])');
    sayac.textContent = `${n} sözcük`;
  });
</script>
